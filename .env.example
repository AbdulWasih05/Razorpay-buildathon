# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# --- Razorpay test mode (P0.2) ---
# Dashboard > Settings > API Keys, in TEST mode. Keys start rzp_test_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# --- Primary LLM: Anthropic (drafting, summarisation, ambiguity flags) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Second provider: used ONLY to generate the out-of-distribution
# held-out corpus (P1.3). A different model family is the point: it is what
# makes the holdout out-of-distribution by construction rather than by promise.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Database ---
DATABASE_URL=postgresql://praman:praman@localhost:5433/praman?schema=public
