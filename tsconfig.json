{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  // apps/ui is excluded here and typechecked by its own config: it is the one
  // package that needs DOM and JSX, and adding those globally would let a
  // browser-only API compile in a Node package without complaint.
  "include": ["packages/*/src", "apps/api/src", "eval", "scripts"],
  "exclude": ["node_modules", "**/dist"]
}
